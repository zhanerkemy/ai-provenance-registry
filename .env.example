# Copy this file to .env and fill it in. Never commit .env (it is in .gitignore).
# Use a new wallet made only for this project, with Sepolia test ETH only.

# Sepolia URL from Alchemy or Infura (free), e.g. https://eth-sepolia.g.alchemy.com/v2/<key>
SEPOLIA_RPC_URL=

# Private key of that test wallet
PRIVATE_KEY=

# Optional: Hugging Face token, only if the downloader hits rate limits
HF_TOKEN=
